default_platform(:ios)
before_all do
  ENV['ITMSTRANSPORTER_FORCE_ITMS_PAC
  KAGE_UPLOAD'] = 'false'
  ENV['FASTLANE_APPLE_APPLICATION_SPECIFIC_PASSWORD']= 'kkih-ytec-rfln-lyts'
end
platform :ios do
  desc "Push a new beta build to TestFlight"
  lane :beta do
    increment_version_number(
      version_number: "1.3" # Set a specific version number
    )
    increment_build_number(
    xcodeproj: "Unity-iPhone.xcodeproj"
  )
    build_app(scheme: "Unity-iPhone",xcargs: "-allowProvisioningUpdates")
    upload_to_testflight(
      itc_provider: "CG4Y9LU6WS"
    )
  end


lane :release do
  produce()

  deliver
end


end

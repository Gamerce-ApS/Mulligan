  - TextID: tutorial.step1_synergies2.dialogue
    Texts:
    - Language: English
      Text: COMBINING 4 WARRIOR UNITS WILL MULTIPLY YOUR TOTAL DAMAGE WITH 3X
    - Language: Spanish
      Text: "4 GUERREROS MULTIPLICAN TU DA\xD1O TOTAL X3"
    - Language: Swedish
